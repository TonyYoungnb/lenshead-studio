<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lenshead Studio | 镜头之下，光影之间</title>
    <meta name="description" content="Lenshead摄影工作室 - 专业商业摄影、人像摄影、活动纪实">
    
    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            /* 🎨 品牌色彩 - 修改这里改变整站配色 */
            --primary-color: #1a1a1a;        /* 主色调：深黑 */
            --accent-color: #d4af37;         /* 强调色：金色 */
            --text-light: #f5f5f5;           /* 浅色文字 */
            --text-gray: #888;               /* 灰色文字 */
            --bg-dark: #0f0f0f;              /* 背景色 */
            
            /* 📐 布局变量 */
            --container-width: 1400px;
            --section-padding: 120px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3 {
            font-family: 'Noto Serif SC', serif;
            font-weight: 700;
        }

        /* 导航栏 */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
            transition: background 0.3s;
        }

        nav.scrolled {
            background: rgba(15, 15, 15, 0.95);
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-light);
            text-decoration: none;
        }

        .logo span {
            color: var(--accent-color);
        }

        .nav-links {
            display: flex;
            gap: 40px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-light);
            text-decoration: none;
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: color 0.3s;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--accent-color);
            transition: width 0.3s;
        }

        .nav-links a:hover {
            color: var(--accent-color);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* 移动端菜单按钮 */
        .menu-toggle {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 5px;
        }

        .menu-toggle span {
            width: 25px;
            height: 2px;
            background: var(--text-light);
            transition: 0.3s;
        }

        /* Hero 区域 */
        .hero {
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('images/hero-bg.jpg'); /* 🖼️ 更换首页背景图 */
            background-size: cover;
            background-position: center;
            filter: brightness(0.4);
            z-index: -1;
        }

        .hero-content {
            text-align: center;
            z-index: 1;
            padding: 0 20px;
            max-width: 900px;
        }

        .hero-subtitle {
            font-size: 14px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--accent-color);
            margin-bottom: 20px;
            opacity: 0;
            animation: fadeInUp 1s ease forwards;
        }

        .hero h1 {
            font-size: clamp(40px, 8vw, 80px);
            line-height: 1.1;
            margin-bottom: 30px;
            opacity: 0;
            animation: fadeInUp 1s ease 0.2s forwards;
        }

        .hero-description {
            font-size: 18px;
            color: var(--text-gray);
            max-width: 600px;
            margin: 0 auto 40px;
            opacity: 0;
            animation: fadeInUp 1s ease 0.4s forwards;
        }

        .cta-button {
            display: inline-block;
            padding: 15px 40px;
            border: 1px solid var(--accent-color);
            color: var(--accent-color);
            text-decoration: none;
            letter-spacing: 2px;
            transition: all 0.3s;
            opacity: 0;
            animation: fadeInUp 1s ease 0.6s forwards;
        }

        .cta-button:hover {
            background: var(--accent-color);
            color: var(--bg-dark);
        }

        /* 滚动提示 */
        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
        }

        .scroll-indicator::before {
            content: '↓';
            font-size: 24px;
            color: var(--accent-color);
        }

        /* 通用区域样式 */
        section {
            padding: var(--section-padding) 20px;
        }

        .container {
            max-width: var(--container-width);
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 80px;
        }

        .section-tag {
            color: var(--accent-color);
            letter-spacing: 3px;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: clamp(32px, 5vw, 48px);
            margin-bottom: 20px;
        }

        .section-desc {
            color: var(--text-gray);
            max-width: 600px;
            margin: 0 auto;
        }

        /* 作品集网格 */
        .portfolio {
            background: var(--primary-color);
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4/3;
            cursor: pointer;
            group: gallery;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        .gallery-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s;
            padding: 20px;
            text-align: center;
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-title {
            font-size: 24px;
            margin-bottom: 10px;
            transform: translateY(20px);
            transition: transform 0.3s;
        }

        .gallery-item:hover .gallery-title {
            transform: translateY(0);
        }

        .gallery-category {
            color: var(--accent-color);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transform: translateY(20px);
            transition: transform 0.3s 0.1s;
        }

        .gallery-item:hover .gallery-category {
            transform: translateY(0);
        }

        /* 关于我们 */
        .about {
            background: var(--bg-dark);
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .about-image {
            position: relative;
        }

        .about-image img {
            width: 100%;
            height: auto;
            filter: grayscale(100%);
            transition: filter 0.5s;
        }

        .about-image:hover img {
            filter: grayscale(0%);
        }

        .about-image::before {
            content: '';
            position: absolute;
            top: -20px;
            left: -20px;
            width: 100%;
            height: 100%;
            border: 2px solid var(--accent-color);
            z-index: -1;
        }

        .about-text h3 {
            font-size: 36px;
            margin-bottom: 30px;
            color: var(--accent-color);
        }

        .about-text p {
            margin-bottom: 20px;
            color: var(--text-gray);
            line-height: 1.8;
        }

        .stats {
            display: flex;
            gap: 40px;
            margin-top: 40px;
            padding-top: 40px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .stat-item h4 {
            font-size: 48px;
            color: var(--accent-color);
            font-family: 'Inter', sans-serif;
            font-weight: 300;
        }

        .stat-item p {
            font-size: 14px;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* 服务 */
        .services {
            background: linear-gradient(to bottom, var(--primary-color), var(--bg-dark));
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .service-card {
            padding: 40px;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--accent-color);
            transform: translateY(100%);
            transition: transform 0.3s;
            z-index: -1;
        }

        .service-card:hover {
            border-color: var(--accent-color);
            color: var(--bg-dark);
        }

        .service-card:hover::before {
            transform: translateY(0);
        }

        .service-icon {
            font-size: 40px;
            margin-bottom: 20px;
        }

        .service-card h3 {
            font-size: 24px;
            margin-bottom: 15px;
        }

        .service-card p {
            color: var(--text-gray);
            font-size: 14px;
            line-height: 1.6;
        }

        .service-card:hover p {
            color: rgba(0,0,0,0.7);
        }

        /* 联系 */
        .contact {
            background: var(--bg-dark);
            position: relative;
        }

        .contact-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
        }

        .contact-info h3 {
            font-size: 36px;
            margin-bottom: 40px;
        }

        .contact-item {
            margin-bottom: 30px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        .contact-item strong {
            display: block;
            color: var(--accent-color);
            margin-bottom: 5px;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
        }

        .contact-item p {
            color: var(--text-gray);
            font-size: 18px;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .form-group {
            position: relative;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 15px 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.2);
            color: var(--text-light);
            font-family: inherit;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-bottom-color: var(--accent-color);
        }

        .form-group label {
            position: absolute;
            left: 0;
            top: 15px;
            color: var(--text-gray);
            transition: all 0.3s;
            pointer-events: none;
        }

        .form-group input:focus + label,
        .form-group input:not(:placeholder-shown) + label,
        .form-group textarea:focus + label,
        .form-group textarea:not(:placeholder-shown) + label {
            top: -10px;
            font-size: 12px;
            color: var(--accent-color);
        }

        .submit-btn {
            padding: 15px 40px;
            background: var(--accent-color);
            color: var(--bg-dark);
            border: none;
            cursor: pointer;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: transform 0.3s;
            margin-top: 20px;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
        }

        /* 页脚 */
        footer {
            background: #000;
            padding: 60px 20px 30px;
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .footer-content {
            max-width: var(--container-width);
            margin: 0 auto;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 40px;
        }

        .social-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

        .social-links a:hover {
            color: var(--accent-color);
        }

        .copyright {
            color: var(--text-gray);
            font-size: 12px;
            letter-spacing: 1px;
        }

        /* 动画 */
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
            from {
                opacity: 0;
                transform: translateY(30px);
            }
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateX(-50%) translateY(0);
            }
            40% {
                transform: translateX(-50%) translateY(-10px);
            }
            60% {
                transform: translateX(-50%) translateY(-5px);
            }
        }

        /* 响应式 */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .menu-toggle {
                display: flex;
            }

            .about-content,
            .contact-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .gallery {
                grid-template-columns: 1fr;
            }

            .stats {
                flex-direction: column;
                gap: 20px;
            }

            section {
                padding: 60px 20px;
            }
        }

        /* 图片懒加载占位 */
        img {
            background: linear-gradient(110deg, #1a1a1a 8%, #2a2a2a 18%, #1a1a1a 33%);
            background-size: 200% 100%;
            animation: shine 1.5s linear infinite;
        }

        img.loaded {
            animation: none;
            background: transparent;
        }

        @keyframes shine {
            to {
                background-position-x: -200%;
            }
        }
    </style>
</head>
